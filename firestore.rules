rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'angelmeier10@gmail.com';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function subscriberActiveFor(planId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/subscribers/$(request.auth.uid))
        && get(/databases/$(database)/documents/subscribers/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/subscribers/$(request.auth.uid)).data.get('activo', true) != false
        && (get(/databases/$(database)/documents/subscribers/$(request.auth.uid)).data.planId == planId
            // La suscripción "global" no tiene un único planId: da acceso a
            // cualquier plan fijo marcado privado (los 4 mapeados en planesFijos).
            || get(/databases/$(database)/documents/subscribers/$(request.auth.uid)).data.categoria == 'global');
    }

    // Datos operativos del entrenador: solo admin.
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    match /exercises/{exerciseId} {
      allow read, write: if isAdmin();
    }

    match /solicitudes/{solicitudId} {
      // El formulario público de anamnesis (anamnesis_digital.html) escribe
      // sin login: se permite crear a cualquiera, pero leer/editar/borrar
      // solo el admin.
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Planes: admin gestiona todo. Planes grupales marcados public:true
    // siguen accesibles sin login (link compartido). El plan fijo de
    // suscripción exige login + suscripción activa para ese planId.
    match /planes/{planId} {
      // Planes existentes no tienen el campo "public" seteado: se tratan
      // como públicos por defecto (compatibilidad con links ya compartidos).
      // Solo un plan marcado explícitamente public:false requiere login +
      // suscripción activa para ese planId.
      //
      // "get" (lectura de un doc puntual, por id ya conocido) sí puede
      // depender de subscriberActiveFor con seguridad. "list" (consultas
      // sobre toda la colección, como la que arma el selector de planes del
      // alumno) NO: comprobado que Firestore no filtra esta condición
      // documento por documento cuando depende de un get() cruzado a otra
      // colección, así que con subscriberActiveFor en el list cualquier
      // alumno logueado podía traerse el plan personalizado (privado) de
      // otro alumno. En list solo se permite lo explícitamente público.
      allow get: if isAdmin()
        || resource.data.get('public', true) != false
        || subscriberActiveFor(planId);
      // A diferencia de "get", acá no se puede usar el default-true de
      // planes viejos sin el campo (get('public', true) != false): probado
      // que con esa condición Firestore no filtra el list por documento y
      // devuelve TODA la colección, incluidos los personales privados, a
      // cualquier alumno logueado. Con igualdad estricta sí filtra bien,
      // pero exige que todo plan público tenga public:true seteado
      // explícitamente (los personales llevan public:false).
      allow list: if isAdmin() || resource.data.public == true;
      allow write: if isAdmin();

      // Progreso individual de un member (alumno logueado) dentro de un plan
      // grupal, separado del documento del plan para poder darle permiso de
      // escritura sin exponer la rutina completa ni el progreso de otros.
      match /progreso/{memberId} {
        allow read, write: if isAdmin()
          || (request.auth != null && request.auth.uid == memberId);
      }
    }

    // Catálogo de planes fijos por categoría: público de solo lectura
    // (no expone datos sensibles, solo el mapeo categoria -> planId).
    match /planesFijos/{categoria} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Config pública del Desafío Glúteos 21 días (mapeo al planId real, para
    // que el alta gratuita pueda resolverlo sin necesitar login de admin).
    // Colección propia (no planesFijos) para que este desafío gratuito no
    // aparezca nunca en el selector de categorías pagas del alumno.
    match /desafioGluteos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Suscriptores (alumnos self-service).
    match /subscribers/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.status == 'pending'
            && !('expiry' in request.resource.data)
            && !('lastPaymentId' in request.resource.data))
        // Desafío Glúteos 21 días: gratuito, acceso inmediato sin pasar por
        // el estado "pending" de pago (no aplica a ninguna otra categoría).
        // A diferencia del alta paga, acá SÍ puede traer "expiry" ya en la
        // creación: se autoasigna sin intervención del admin (21 días desde
        // hoy), no hay webhook de pago que lo setee después.
        || (isOwner(uid)
            && request.resource.data.categoria == 'desafio-gluteos-21'
            && request.resource.data.status == 'active'
            && !('lastPaymentId' in request.resource.data));
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.status == resource.data.status
            && request.resource.data.expiry == resource.data.expiry
            && request.resource.data.lastPaymentId == resource.data.lastPaymentId
            && request.resource.data.categoria == resource.data.categoria
            && request.resource.data.planId == resource.data.planId)
        // Renovación del Desafío Glúteos: el propio dueño puede actualizar
        // su "expiry" mientras la categoría siga siendo la del desafío antes
        // y después del cambio (no permite migrarse a otra categoría paga
        // por su cuenta ni tocar lastPaymentId).
        || (isOwner(uid)
            && resource.data.categoria == 'desafio-gluteos-21'
            && request.resource.data.categoria == 'desafio-gluteos-21'
            && request.resource.data.status == 'active'
            && request.resource.data.planId == resource.data.planId
            && request.resource.data.lastPaymentId == resource.data.get('lastPaymentId', null));
      allow delete: if isAdmin();
    }

    // Metadata de la app (ej. categorías de ejercicios).
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    // Historial global de máximos/últimos por ejercicio, por persona
    // (personKey = nombre+email normalizados, no por uid: la misma persona
    // puede existir en clients, subscribers o un plan grupal con ids
    // distintos — ver docs/superpowers/specs/2026-08-11-historial-maximos-ejercicio-design.md).
    // Dato de baja sensibilidad (pesos/repeticiones), por eso cualquier
    // request autenticado puede leer y escribir, no solo el dueño.
    // "list" queda restringido a admin: el docId es "nombre|email", así que
    // permitir list a cualquier autenticado dejaría enumerar toda la
    // colección y ver nombre+email de todos los alumnos.
    match /exHistory/{personKey} {
      allow get, write: if request.auth != null;
      allow list: if isAdmin();
    }
  }
}
